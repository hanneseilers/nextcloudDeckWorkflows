# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local virtual environments
.venv/
venv/

# AI
.claude/

# Runtime state (recreated automatically per deployment)
automation/var/*
!automation/var/.gitkeep

# Real Nextcloud credentials & settings (copy the matching *.example.yaml)
config/nextcloud.yaml
config/settings.yaml
config/smtp.yaml
# Backups configure.sh makes of those (they hold the same passwords)
config/*.yaml.bak
# Decrypts any encrypted_app_password in nextcloud.yaml - see
# automation/config/secrets.py. Never commit this.
config/secret.key

# Workflow definitions are runtime data created via the website, not source
workflows/**/*.yaml
!workflows/.gitkeep

# Build output of tools/build.sh - generated, never committed
build/
