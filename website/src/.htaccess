# Apache: block direct HTTP access to the PHP classes in this folder - they are
# only ever require'd by the entry scripts in website/, never requested directly.
<IfModule mod_authz_core.c>
    # Apache >= 2.4
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache < 2.4
    Order allow,deny
    Deny from all
</IfModule>
